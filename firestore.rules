rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidCategory(cat) {
      return cat is string && cat.size() >= 1 && cat.size() <= 30 && (
        cat == 'Food & Canteen' ||
        cat == 'Travel & Commute' ||
        cat == 'Shopping' ||
        cat == 'Outings & Fun' ||
        cat == 'Books & Study' ||
        cat == 'Bills & Recharge' ||
        cat == 'Other'
      );
    }

    function isValidPaymentMethod(method) {
      return method is string && method.size() >= 1 && method.size() <= 20 && (
        method == 'UPI' ||
        method == 'Cash' ||
        method == 'Card' ||
        method == 'Bank Transfer'
      );
    }

    function isValidPersona(persona) {
      return persona is string && persona.size() >= 1 && persona.size() <= 30 && (
        persona == 'College Student' ||
        persona == 'MBA Student' ||
        persona == 'Fresh Graduate' ||
        persona == 'Young Professional'
      );
    }

    function isValidPlan(plan) {
      return plan is string && plan.size() >= 1 && plan.size() <= 10 && (
        plan == 'free' ||
        plan == 'trial' ||
        plan == 'plus'
      );
    }

    function isValidWtp(wtp) {
      return wtp is string && wtp.size() >= 1 && wtp.size() <= 16 && (
        wtp == 'undecided' ||
        wtp == 'yes' ||
        wtp == 'maybe' ||
        wtp == 'no'
      );
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthKey(m) {
      return m is string && m.size() == 7 && m.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'persona',
        'campusOrCity',
        'monthlyAllowance',
        'monthlySavingsTarget',
        'plan',
        'trialStartedAt',
        'referralCode',
        'willingnessToPay99',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'persona',
        'campusOrCity',
        'monthlyAllowance',
        'monthlySavingsTarget',
        'plan',
        'trialStartedAt',
        'referralCode',
        'willingnessToPay99',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == userId &&
      data.uid == request.auth.uid &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 80 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 150 &&
      data.email == request.auth.token.email &&
      isValidPersona(data.persona) &&
      data.campusOrCity is string &&
      data.campusOrCity.size() <= 100 &&
      data.monthlyAllowance is number &&
      data.monthlyAllowance >= 0 &&
      data.monthlyAllowance <= 10000000 &&
      data.monthlySavingsTarget is number &&
      data.monthlySavingsTarget >= 0 &&
      data.monthlySavingsTarget <= 10000000 &&
      isValidPlan(data.plan) &&
      data.trialStartedAt is string &&
      data.trialStartedAt.size() <= 40 &&
      data.referralCode is string &&
      data.referralCode.size() >= 4 &&
      data.referralCode.size() <= 24 &&
      data.referralCode.matches('^[A-Z0-9\\-]+$') &&
      isValidWtp(data.willingnessToPay99) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll([
        'userId',
        'title',
        'amount',
        'category',
        'paymentMethod',
        'date',
        'monthKey',
        'note',
        'isRecurringInstance',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'title',
        'amount',
        'category',
        'paymentMethod',
        'date',
        'monthKey',
        'note',
        'isRecurringInstance',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == userId &&
      data.userId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 100 &&
      data.amount is number &&
      data.amount > 0 &&
      data.amount <= 10000000 &&
      isValidCategory(data.category) &&
      isValidPaymentMethod(data.paymentMethod) &&
      isValidDateString(data.date) &&
      isValidMonthKey(data.monthKey) &&
      data.date[0:7] == data.monthKey &&
      data.note is string &&
      data.note.size() <= 240 &&
      data.isRecurringInstance is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCategoryBudget(data, userId) {
      return data.keys().hasAll([
        'userId',
        'category',
        'monthKey',
        'monthlyLimit',
        'alertThresholdPct',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'category',
        'monthKey',
        'monthlyLimit',
        'alertThresholdPct',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == userId &&
      data.userId == request.auth.uid &&
      isValidCategory(data.category) &&
      isValidMonthKey(data.monthKey) &&
      data.monthlyLimit is number &&
      data.monthlyLimit > 0 &&
      data.monthlyLimit <= 10000000 &&
      data.alertThresholdPct is number &&
      data.alertThresholdPct >= 50 &&
      data.alertThresholdPct <= 100 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSavingsGoal(data, userId) {
      return data.keys().hasAll([
        'userId',
        'name',
        'targetAmount',
        'savedAmount',
        'targetDate',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'name',
        'targetAmount',
        'savedAmount',
        'targetDate',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == userId &&
      data.userId == request.auth.uid &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 80 &&
      data.targetAmount is number &&
      data.targetAmount > 0 &&
      data.targetAmount <= 10000000 &&
      data.savedAmount is number &&
      data.savedAmount >= 0 &&
      data.savedAmount <= 10000000 &&
      isValidDateString(data.targetDate) &&
      data.status is string &&
      data.status.size() >= 1 &&
      data.status.size() <= 16 &&
      (data.status == 'active' || data.status == 'completed') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidRecurringBill(data, userId) {
      return data.keys().hasAll([
        'userId',
        'title',
        'amount',
        'category',
        'paymentMethod',
        'dayOfMonth',
        'lastAppliedMonth',
        'active',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'title',
        'amount',
        'category',
        'paymentMethod',
        'dayOfMonth',
        'lastAppliedMonth',
        'active',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == userId &&
      data.userId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 100 &&
      data.amount is number &&
      data.amount > 0 &&
      data.amount <= 10000000 &&
      isValidCategory(data.category) &&
      isValidPaymentMethod(data.paymentMethod) &&
      data.dayOfMonth is int &&
      data.dayOfMonth >= 1 &&
      data.dayOfMonth <= 28 &&
      data.lastAppliedMonth is string &&
      data.lastAppliedMonth.size() <= 7 &&
      (data.lastAppliedMonth == '' || isValidMonthKey(data.lastAppliedMonth)) &&
      data.active is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll([
        'userId',
        'authorName',
        'authorRole',
        'rating',
        'title',
        'comment',
        'verifiedEmail',
        'isPublished',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'authorName',
        'authorRole',
        'rating',
        'title',
        'comment',
        'verifiedEmail',
        'isPublished',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == reviewId &&
      data.userId == request.auth.uid &&
      data.authorName is string &&
      data.authorName.size() >= 1 &&
      data.authorName.size() <= 80 &&
      data.authorRole is string &&
      data.authorRole.size() >= 1 &&
      data.authorRole.size() <= 80 &&
      data.rating is int &&
      data.rating >= 1 &&
      data.rating <= 5 &&
      data.title is string &&
      data.title.size() >= 3 &&
      data.title.size() <= 100 &&
      data.comment is string &&
      data.comment.size() >= 10 &&
      data.comment.size() <= 600 &&
      data.verifiedEmail == true &&
      data.isPublished == true &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Private User Profiles (PII Isolated)
    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().referralCode == existing().referralCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Update profile & budgeting preferences
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'persona',
            'campusOrCity',
            'monthlyAllowance',
            'monthlySavingsTarget',
            'updatedAt'
          ]) ||
          // Action: Update subscription plan / trial status
          incoming().diff(existing()).affectedKeys().hasOnly([
            'plan',
            'trialStartedAt',
            'updatedAt'
          ]) ||
          // Action: Submit pricing willingness-to-pay feedback
          incoming().diff(existing()).affectedKeys().hasOnly([
            'willingnessToPay99',
            'updatedAt'
          ])
        );
      allow delete: if false;

      // 2. Daily Expenses Subcollection
      match /expenses/{expenseId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
        allow list: if isVerifiedOwner(userId) &&
          existing().userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          isValidExpense(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          isValidExpense(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'amount',
            'category',
            'paymentMethod',
            'date',
            'monthKey',
            'note',
            'updatedAt'
          ]) &&
          parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }

      // 3. Monthly Category Budgets Subcollection
      match /budgets/{budgetId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
        allow list: if isVerifiedOwner(userId) &&
          existing().userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          isValidCategoryBudget(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          isValidCategoryBudget(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().category == existing().category &&
          incoming().monthKey == existing().monthKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'monthlyLimit',
            'alertThresholdPct',
            'updatedAt'
          ]) &&
          parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(budgetId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }

      // 4. Savings Goals Subcollection (with Terminal State Lock)
      match /goals/{goalId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
        allow list: if isVerifiedOwner(userId) &&
          existing().userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidSavingsGoal(incoming(), userId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidSavingsGoal(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          existing().status != 'completed' &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            // Action: Contribute to goal or update details
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'targetAmount',
              'savedAmount',
              'targetDate',
              'status',
              'updatedAt'
            ])
          ) &&
          parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }

      // 5. Automated Recurring Bills Subcollection
      match /recurring/{recurringId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(recurringId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
        allow list: if isVerifiedOwner(userId) &&
          existing().userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(recurringId) &&
          isValidRecurringBill(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(recurringId) &&
          isValidRecurringBill(incoming(), userId) &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            // Action: Edit recurring rule
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'amount',
              'category',
              'paymentMethod',
              'dayOfMonth',
              'active',
              'updatedAt'
            ]) ||
            // Action: Mark recurring bill auto-applied for current month
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastAppliedMonth',
              'updatedAt'
            ])
          ) &&
          parentUserExists(userId);
        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(recurringId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }
    }

    // 6. Verified User Reviews & Ratings (Public PII-Free Read, Verified Author Write)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().isPublished == true;
      allow list: if existing().isPublished == true;
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        reviewId == request.auth.uid &&
        isValidReview(incoming(), reviewId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        parentUserExists(request.auth.uid);
      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        reviewId == request.auth.uid &&
        isValidReview(incoming(), reviewId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName',
          'authorRole',
          'rating',
          'title',
          'comment',
          'updatedAt'
        ]) &&
        parentUserExists(request.auth.uid);
      allow delete: if isVerifiedUser() &&
        isValidId(reviewId) &&
        reviewId == request.auth.uid &&
        existing().userId == request.auth.uid &&
        parentUserExists(request.auth.uid);
    }
  }
}
